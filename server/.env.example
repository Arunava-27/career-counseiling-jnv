# Copy this file to server/.env and fill in real values.
# .env is git-ignored — never commit real passwords or tokens.

# Required for login (both local and deployed). Format: name:password,name:password
# Pick your own usernames/passwords — these are just examples.
AUTH_USERS=kunal:choose-a-password,priya:choose-a-password

# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-this-to-a-long-random-string

# Leave both of these unset for local/offline use — the app will use a local SQLite
# file at server/data/career-counseling.db automatically. Only set them when deploying
# to a host like Render, so both instructors share one online database. See
# docs/DEPLOY.md for how to create a free Turso database and get these values.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
